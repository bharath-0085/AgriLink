# ============================================================
# Agri Link — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# --- Virtual Environments ---
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.env
firebase-service-account.json
*.pem
*.key
*.cert
*.crt
credentials.json
secrets.json

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Operating System ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- AI Model Files in AI/ folder ---
AI/crop_recommendation/*.pkl
AI/disease_detection/*.keras

# --- Temporary / Cache ---
*.bak
*.tmp
.cache/
.pytest_cache/
